OPENAI_API_KEY=sk-your-key-here
# optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: to use OpenRouter instead of OpenAI directly, uncomment below.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_MODEL=openai/gpt-4o-mini

# Port this server listens on (Railway sets PORT automatically - leave unset there)
PORT=4000

# Comma-separated list of origins allowed to call this API (your Vercel
# frontend's URL, plus http://localhost:3000 for local dev). Use "*" to
# allow any origin (fine for local testing, not recommended in production).
ALLOWED_ORIGINS=http://localhost:3000,https://funnel-tester-three.vercel.app

# Shared secret every caller must send as "Authorization: Bearer <key>"
# (/health stays open). Set this wherever the server is reachable from the
# internet (e.g. Railway) - without it anyone can start real-lead runs. Use
# the same value as FUNNEL_TESTER_API_KEY in the uptime app. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FUNNEL_TESTER_API_KEY=

# Optional: folder where reports/ and screenshots/ are saved (defaults to
# this backend folder). On Railway, attach a Volume (e.g. mounted at /data)
# and set DATA_DIR=/data - otherwise every redeploy, including the one a
# variable change triggers, deletes all saved reports and screenshots.
# DATA_DIR=/data

# Optional: set to "false" to run the browser with a visible window instead
# of headless, so you can watch the AI walker fill the form live. Only
# works on a machine with a display (your own PC, not a headless
# server/Railway) - leave unset (headless) in production.
# WBT_HEADLESS=false

# Optional: lets the walker read a real OTP code sent to your Twilio
# number and enter it automatically when a funnel has phone verification.
# Without these, an OTP step is reported as blocked instead of crashing.
# TWILIO_ACCOUNT_SID=ACyour-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBERS=+1your-first-number,+1your-second-number
# Comma-separated list of one or more Twilio numbers. Each funnel walk
# round-robins to the next number in the list (alternating every run,
# in-memory, resets on restart), so OTP volume/anti-fraud flags spread
# across numbers instead of hammering one. A single entry works too - it's
# just used every time. Whichever number is selected for a given run is
# both filled into the test-identity phone field AND polled for the inbound
# OTP SMS - they can't drift apart, since aiWalker.ts threads the selected
# number through explicitly instead of reading a hardcoded constant.
